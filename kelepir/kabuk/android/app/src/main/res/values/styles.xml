<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Taban tema: oyun tamamen koyu, o yüzden sistem teması da koyu.
         Varsayılan Light.DarkActionBar bırakılırsa açılışta beyaz bir kare
         görünüyordu. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/kelepirZemin</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/kelepirZemin</item>
        <!-- Android 15+ pencereyi zorunlu kenardan kenara açıyor; çubuklar
             saydam olmalı, dolguyu web tarafı güvenli alandan alıyor. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/kelepirZemin</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
